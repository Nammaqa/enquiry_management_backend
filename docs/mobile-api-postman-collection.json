                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/student-batches/{{batchId}}/details",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student-batches", "{{batchId}}", "details"]
            },
            "description": "Retrieves comprehensive batch schedule, instructor details, and subject curriculum."
          }
        },
        {
          "name": "List Available Packages",
