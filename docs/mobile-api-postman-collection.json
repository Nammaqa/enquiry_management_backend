                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/student-batches",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student-batches"]
            },
            "description": "Lists all active/completed batches the authenticated student is assigned to."
          }
        },
        {
          "name": "Get Batch Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
