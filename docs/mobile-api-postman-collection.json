            "description": "Returns all unique domains (Testing, Development, Cybersecurity, etc.) for app category filters."
          }
        }
      ]
    },
    {
      "name": "4. Attendance Management",
      "description": "QR attendance scanning and student attendance logs.",
      "item": [
        {
          "name": "Mark Attendance (Scan QR Code)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": 1,\n  \"qrToken\": \"eyJhbGciOiJIUzI1Ni...\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/mark",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "mark"]
            },
            "description": "Called by mobile app after scanning the instructor's classroom QR code."
          }
        },
        {
