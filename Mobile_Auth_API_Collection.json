{
  "info": {
    "_postman_id": "mobile-auth-api",
    "name": "Mobile Auth APIs - OTP Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signup with OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"John Doe\",\n  \"phone_number\": \"9876543210\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mobile/auth/signup",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mobile", "auth", "signup"]
        },
        "description": "Step 1: Send signup details. OTP will be generated and sent to the phone number via WhatsApp. Returns reference_id for tracking. OTP expires in 10 minutes."
      }
    },
    {
      "name": "1.1 Resend Signup OTP (If Expired)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 14,\n  \"phone_number\": \"9876543210\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mobile/auth/resend-signup-otp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mobile", "auth", "resend-signup-otp"]
        },
        "description": "If signup OTP expires (10 min), resend OTP with user_id and phone_number."
      }
    },
    {
      "name": "2. Verify OTP & Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 14,\n  \"phone_number\": \"9876543210\",\n  \"otp_code\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mobile/auth/verify-otp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mobile", "auth", "verify-otp"]
        },
        "description": "Step 2: Verify OTP with user_id, phone_number, and otp_code. Returns JWT token + user details."
      }
    },
    {
      "name": "3.1 Login - Phone Number + Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"9876543210\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mobile/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mobile", "auth", "login"]
        },
        "description": "Login with phone number and password to get JWT token."
      }
    },
    {
      "name": "3.2a Login - Send OTP (Phone Number)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"9876543210\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mobile/auth/send-login-otp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mobile", "auth", "send-login-otp"]
        },
        "description": "Send login OTP to user's phone with phone_number only. OTP sent via WhatsApp. Expires in 10 minutes."
      }
    },
    {
      "name": "3.2b Login - Resend OTP (If Expired)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"9876543210\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mobile/auth/resend-login-otp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mobile", "auth", "resend-login-otp"]
        },
        "description": "If login OTP expires (10 min), resend with phone_number only. Generates new OTP."
      }
    },
    {
      "name": "3.2c Login - Phone Number + OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"9876543210\",\n  \"otp_code\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mobile/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mobile", "auth", "login"]
        },
        "description": "Step 2: Login with phone number and OTP received via WhatsApp. Returns JWT token."
      }
    }
  ]
}
